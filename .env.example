# GitHub API 인증 토큰
# GitHub Security Advisories API 호출 시 사용
# https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token

# Slack 알림 전송용 Incoming Webhook URL
SLACK_WEBHOOK_URL=your_slack_web_hook_url

# Notion API 인증 토큰
# https://www.notion.so/profile/integrations
NOTION_TOKEN=your_notion_token

# Notion 페이지 생성 시 부모로 사용할 페이지 ID
NOTION_PARENT_PAGE_ID=your_notion_parent_page_id

# GitHub Security Advisory 데이터를 저장할 Notion Data Source ID
NOTION_ADVISORIES_DATA_SOURCE_ID=your_data_source_id

# 사내 서비스 데이터를 저장할 Notion Data Source ID
NOTION_SERVICE_DATA_SOURCE_ID=your_data_source_id

# 사내 서비스 패키지 데이터를 저장할 Notion Data Source ID
NOTION_SERVICE_PACKAGE_DATA_SOURCE_ID=your_data_source_id